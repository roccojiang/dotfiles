{
  "meta": {
    "name": "claude",
    "version": "1.0.0"
  },
  "extends": "claude-code",
  "network": {
    "block": false
  },
  "policy": {
    "add_allow_read": [
      "$HOME/.config/git",
      "$HOME/.local/share/themes",
      "$HOME/.local/share/mise",
      "$HOME/Library/Application Support/cmux"
    ]
  }
}
